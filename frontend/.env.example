# ==============================================================================
# INSTALLMENT MANAGEMENT SYSTEM 6 — FRONTEND PRODUCTION CONFIGURATION
# ==============================================================================
# In production, set VITE_API_URL to your deployed backend API URL (e.g. https://api.yourdomain.com/api or /api if reverse-proxied).
# Leave as /api if frontend and backend share the same domain.
VITE_API_URL=https://api.yourdomain.com/api

# Application Display Name
VITE_APP_NAME=Installment Management System
