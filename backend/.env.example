# ==============================================================================
# Installment Management System (IMS 6) - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to `backend/.env` and replace placeholders with your actual secrets.
# NEVER commit the real `.env` file to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Both MONGODB_URI and MONGO_URI are supported)
MONGODB_URI=mongodb://127.0.0.1:27017/installment_management3

# JWT Authentication Configuration
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Emergency Disaster Recovery Admin (Optional fallback if database has zero admins)
# Set strong, non-default credentials for disaster recovery mode
ADMIN_NAME=Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_SETUP_KEY=your_strong_admin_setup_key_here

# Backup Encryption Configuration
# 64-character hex key (AES-256-GCM) or a strong passphrase for PBKDF2 derivation
BACKUP_ENCRYPTION_KEY=your_64_character_hex_master_encryption_key_here
BACKUP_ENCRYPTION_PASSPHRASE=your_optional_backup_passphrase_here

# Automated Backup Cron Webhook Secret
# Required to trigger /api/backup/cron via external monitoring or webhook services
# Generate using: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BACKUP_CRON_SECRET=your_long_random_cron_webhook_secret_here

# Google Drive Cloud Backup Integration (OAuth 2.0 Client Credentials)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/backup/oauth/callback

# Frontend URL (For OAuth callback redirects and CORS)
CLIENT_URL=http://localhost:5173
