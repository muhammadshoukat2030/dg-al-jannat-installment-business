# ==============================================================================
# INSTALLMENT MANAGEMENT SYSTEM 6 — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual production credentials.
# NEVER commit your real .env file or credentials to Git or public repositories.

# --- SERVER ENVIRONMENT ---
NODE_ENV=production
PORT=5000

# --- DATABASE CONNECTION (MongoDB Atlas or Self-Hosted) ---
# Supported variables: MONGODB_URI or MONGO_URI
# Ensure IP Access List in MongoDB Atlas allows your production host IP (or 0.0.0.0/0 with strong credentials).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/installment_system?retryWrites=true&w=majority

# --- AUTHENTICATION & SECURITY (JWT) ---
# Generate a cryptographically secure 64-character secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# --- CORS & CLIENT DOMAINS ---
# Set to your production frontend domain (without trailing slash).
# Multiple domains can be comma-separated in ALLOWED_ORIGINS (e.g. https://yourdomain.com,https://www.yourdomain.com).
CLIENT_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- INITIAL ADMINISTRATOR CREDENTIALS ---
# Used by "npm run setup-admin" to seed the initial database admin account.
# Note: Choose strong, unique credentials. Hardcoded default fallbacks are strictly rejected for security.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_SETUP_KEY=replace_with_random_confirmation_key

# --- DATABASE BACKUP CRYPTOGRAPHY (AES-256-GCM) ---
# 64-character hex master key used to encrypt and decrypt all .imsbak archives.
# Generate once and store in your emergency recovery kit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=replace_with_64_character_hex_master_encryption_key

# --- BACKUP CRON WEBHOOK SECURITY ---
# Secret required in Authorization header ("Bearer <BACKUP_CRON_SECRET>") for automated cron triggers.
BACKUP_CRON_SECRET=replace_with_random_cron_secret

# --- GOOGLE DRIVE CLOUD BACKUP INTEGRATION (OAuth 2.0) ---
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs:
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must exactly match the Authorized Redirect URI in Google Cloud Console:
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/backup/gdrive/callback
